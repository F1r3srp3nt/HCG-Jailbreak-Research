+from hcgrepo.config import ConfigError, load_config
+from hcgrepo.server import BackgroundServer
+from hcgrepo.site import ACADEMY_PATH, BuildError, build
+from hcgrepo.verify import verify
+
+PROD = "https://repo.hakmicapitalgroup.com/"
+
+
+class AcademyTests(RepoTestCase):
+    def setUp(self):
+        super().setUp()
+        shutil.copytree(REPO / "academy", self.root / "academy")
+
+    def set_enabled(self, value: str):
+        p = self.root / "config" / "repo.toml"
+        text = re.sub(r"(?m)^enabled = .*$", f"enabled = {value}", p.read_text())
+        p.write_text(text)
+        return self.reload()
+
+    def test_repository_ships_it_disabled(self):
+        self.assertFalse(load_config(REPO).academy_enabled)
+
+    def test_disabled_build_has_no_academy_and_no_link(self):
+        out = build(self.cfg, PROD, self.tmp / "site").out_dir
+        self.assertFalse((out / "academy").exists())
+        self.assertNotIn(ACADEMY_PATH, (out / "index.html").read_text())
+        self.assertNotIn(ACADEMY_PATH, (out / "404.html").read_text())
+
+    def test_enabled_build_publishes_guide_and_links_it(self):
+        self.set_enabled("true")
+        out = build(self.cfg, PROD, self.tmp / "site").out_dir
+        guide = out / "academy" / "jailbreak" / "index.html"
+        self.assertTrue(guide.is_file())
+        self.assertFalse((out / "academy" / "data").exists())
+        self.assertIn(f'href="{ACADEMY_PATH}">Academy</a>', (out / "index.html").read_text())
+        for prod in (out / "products").iterdir():
+            self.assertIn(f'href="../../{ACADEMY_PATH}">Academy</a>', (prod / "index.html").read_text())
+        # every local file the guide references exists in the built site
+        html = guide.read_text()
+        refs = re.findall(r'(?:src|href)="((?:\.\./|\./)[^"#?]*)"', html)
+        self.assertTrue(refs)
+        for ref in refs:
+            if ref.startswith("../../repo/"):
+                continue   # package pages depend on the real package index, which this fixture does not have
+            target = (guide.parent / ref).resolve()
+            if ref.endswith("/"):
+                target = target / "index.html"
+            self.assertTrue(target.is_file(), f"{ref} -> {target}")
+        # images referenced from the guide's own assets exist as well
+        for svg in re.findall(r'src="\.\./assets/img/([^"]+)"', html):
+            self.assertTrue((out / "academy" / "assets" / "img" / svg).is_file(), svg)
+        # the candidate source does not get a copy
+        self.assertFalse((out / "repo" / "candidate" / "academy").exists())
+
+    def test_enabled_build_still_verifies(self):
+        self.set_enabled("true")
+        out = build(self.cfg, PROD, self.tmp / "site").out_dir
+        with BackgroundServer(out, "/") as srv:
+            v = verify(PROD, srv.url, cfg=self.cfg)
+        self.assertTrue(v.report.ok, v.report.render())
+
+    def test_enabled_without_files_fails_the_build(self):
+        self.set_enabled("true")
+        (self.root / "academy" / "assets" / "compat.js").unlink()
+        with self.assertRaises(BuildError):
+            build(self.cfg, PROD, self.tmp / "site")
+
+    def test_enabled_must_be_boolean(self):
+        with self.assertRaises(ConfigError):
+            self.set_enabled('"false"')
