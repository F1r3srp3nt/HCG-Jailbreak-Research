+def copy_academy(cfg: RepoConfig, site: Path) -> None:
+    """Publish academy/ as <site>/academy/ (static files only). Called only when [academy] enabled = true.
+
+    The guide is self-contained HTML, CSS, JavaScript and SVG; it links the site's own assets/site.css and brand
+    files, so it must be published inside this site. Reviewer-only material (academy/data/, README.md) is skipped."""
+    src = cfg.root / ACADEMY_DIR
+    missing = [f for f in ACADEMY_REQUIRED if not (src / f).is_file()]
+    if missing:
+        raise BuildError(f"[academy] enabled = true but academy/ is incomplete: missing {', '.join(missing)}")
+    allowed = {".html", ".css", ".js", ".svg", ".png", ".jpg", ".webp"}
+    for f in sorted(src.rglob("*")):
+        rel = f.relative_to(src)
+        if not f.is_file() or rel.parts[0] == "data" or f.name.startswith(".") or f.suffix.lower() not in allowed:
+            continue
+        dst = site / ACADEMY_DIR / rel
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(f, dst)
+
